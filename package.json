{
  "name": "testlearning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Baby care guide plus a public message board, served by a Cloudflare Worker with static assets and D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-timeout=120000 \"test/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
